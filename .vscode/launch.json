{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (Contoso sample)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/samples/contoso-it-helpdesk"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
