{
  "name": "cps-agent-forge",
  "displayName": "Agent Forge for Copilot Studio",
  "description": "Design, lint, evaluate and ship multi-agent orchestrators for Microsoft Copilot Studio: architecture graph, 25 policy rules with quick fixes, blueprint wizard, evaluation studio, safe pac lifecycle, CLI/SARIF and MCP server.",
  "version": "0.4.3",
  "preview": true,
  "private": true,
  "publisher": "AbhilashJaiswal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhilashjaiswal0110/Agent-Forge-for-Copilot-Studio.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Linters",
    "Snippets",
    "Testing",
    "Visualization"
  ],
  "keywords": [
    "copilot studio",
    "multi-agent",
    "orchestrator",
    "agents",
    "power platform",
    "mcp",
    "evaluation",
    "lint"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/settings.mcs.yml",
    "workspaceContains:**/agent.mcs.yml"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces Agent Forge only analyses files (explorer, lint, graph). Lifecycle commands that run the Power Platform CLI require trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "agentForge.refresh",
        "title": "Refresh Agents",
        "category": "Agent Forge",
        "icon": "$(refresh)"
      },
      {
        "command": "agentForge.lint",
        "title": "Lint Workspace",
        "category": "Agent Forge"
      },
      {
        "command": "agentForge.showGraph",
        "title": "Show Architecture Graph",
        "category": "Agent Forge",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "agentForge.pull",
        "title": "Pull Agent (pac copilot pull)",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.push",
        "title": "Push Agent as Draft (pac copilot push)",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.publish",
        "title": "Publish Agent (pac copilot publish)",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.configureBrowser",
        "title": "Configure Browser Co-pilot (Playwright MCP)",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.installSkills",
        "title": "Install Copilot Studio Skills into Workspace",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.fixAll",
        "title": "Apply All Safe Quick Fixes",
        "category": "Agent Forge",
        "icon": "$(wand)"
      },
      {
        "command": "agentForge.disableRule",
        "title": "Disable Lint Rule...",
        "category": "Agent Forge"
      },
      {
        "command": "agentForge.configureLintServer",
        "title": "Configure Agent Forge MCP Server (lint, inventory, Mermaid)",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.openWalkthrough",
        "title": "Get Started",
        "category": "Agent Forge",
        "icon": "$(question)"
      },
      {
        "category": "Agent Forge",
        "command": "agentForge.newBlueprint",
        "title": "New Orchestrator Blueprint...",
        "icon": "$(add)"
      },
      {
        "category": "Agent Forge",
        "command": "agentForge.newTestSet",
        "title": "New Evaluation Test Set"
      },
      {
        "category": "Agent Forge",
        "command": "agentForge.validateTestSet",
        "title": "Validate Evaluation CSV"
      },
      {
        "category": "Agent Forge",
        "command": "agentForge.analyzeResults",
        "title": "Analyse Evaluation Results"
      },
      {
        "category": "Agent Forge",
        "command": "agentForge.runBrowserRecipe",
        "title": "Run Browser Recipe...",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "category": "Agent Forge",
        "command": "agentForge.installGitHook",
        "title": "Install Guardrail Git Hook (lint before commit)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.openSample",
        "title": "Open Contoso Sample",
        "category": "Agent Forge"
      },
      {
        "command": "agentForge.addEnvironmentProfile",
        "title": "Add Environment Profile...",
        "category": "Agent Forge"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentForge",
          "title": "Agent Forge",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "agentForge": [
        {
          "id": "agentForge.agents",
          "name": "Agents"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentForge.agents",
        "contents": "No Copilot Studio agent found in this workspace.\nClone one with the Power Platform CLI (pac copilot clone), or design a new multi-agent solution.\n[New Orchestrator Blueprint](command:agentForge.newBlueprint)\n[Refresh](command:agentForge.refresh)\n[Get Started](command:agentForge.openWalkthrough)\n[Open Contoso Sample](command:agentForge.openSample)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentForge.refresh",
          "when": "view == agentForge.agents",
          "group": "navigation"
        },
        {
          "command": "agentForge.showGraph",
          "when": "view == agentForge.agents",
          "group": "navigation"
        },
        {
          "command": "agentForge.fixAll",
          "when": "view == agentForge.agents",
          "group": "navigation@3"
        },
        {
          "command": "agentForge.openWalkthrough",
          "when": "view == agentForge.agents",
          "group": "navigation@9"
        },
        {
          "command": "agentForge.newBlueprint",
          "when": "view == agentForge.agents",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "agentForge.pull",
          "when": "view == agentForge.agents && viewItem == agent",
          "group": "lifecycle@1"
        },
        {
          "command": "agentForge.push",
          "when": "view == agentForge.agents && viewItem == agent",
          "group": "lifecycle@2"
        },
        {
          "command": "agentForge.publish",
          "when": "view == agentForge.agents && viewItem == agent",
          "group": "lifecycle@3"
        },
        {
          "command": "agentForge.newTestSet",
          "when": "view == agentForge.agents && viewItem == agent",
          "group": "evals@1"
        },
        {
          "command": "agentForge.addEnvironmentProfile",
          "when": "view == agentForge.agents && viewItem == agent",
          "group": "lifecycle@9"
        }
      ],
      "explorer/context": [
        {
          "command": "agentForge.validateTestSet",
          "when": "resourceExtname == .csv",
          "group": "agentForge@1"
        },
        {
          "command": "agentForge.analyzeResults",
          "when": "resourceExtname == .csv",
          "group": "agentForge@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agentForge.disableRule",
          "when": "agentForge.hasAgents"
        }
      ]
    },
    "configuration": {
      "title": "Agent Forge",
      "properties": {
        "agentForge.pacPath": {
          "type": "string",
          "default": "pac",
          "description": "Path to the Power Platform CLI executable."
        },
        "agentForge.lint.disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Rule IDs to disable, for example [\"DESC002\"]."
        },
        "agentForge.browser.profile": {
          "type": "string",
          "enum": [
            "isolated",
            "extension"
          ],
          "default": "isolated",
          "enumDescriptions": [
            "Playwright MCP uses an isolated, in-memory browser profile (recommended).",
            "Playwright MCP attaches to your signed-in Edge/Chrome via the Playwright browser extension."
          ],
          "description": "Browser profile used by the browser co-pilot (Playwright MCP)."
        },
        "agentForge.environments": {
          "type": "array",
          "default": [],
          "markdownDescription": "Environment profiles. Agents are matched by the environment id or Dataverse URL in `.mcs/conn.json`; the stage is shown in the Agent Forge view and guards push, publish and the blueprint wizard. Use **Agent Forge: Add Environment Profile**.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind"
            ],
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "id"
                ]
              }
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Short label, for example \"Contoso Dev\". Typed to confirm production steps."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "dev",
                  "test",
                  "prod"
                ],
                "description": "Stage of the environment."
              },
              "url": {
                "type": "string",
                "pattern": "^https://",
                "description": "Dataverse environment URL, for example https://contoso-dev.crm.dynamics.com/"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                "description": "Environment id (GUID)."
              }
            }
          }
        },
        "agentForge.productionGuard": {
          "type": "string",
          "enum": [
            "confirm",
            "block",
            "off"
          ],
          "default": "confirm",
          "enumDescriptions": [
            "Type the production profile name before push, publish or creating agents.",
            "Refuse push, publish and creating agents in production environments.",
            "No extra check for production."
          ],
          "description": "What to do before a step changes an environment whose profile is \"prod\"."
        },
        "agentForge.requireEnvironmentProfile": {
          "type": "boolean",
          "default": false,
          "description": "Refuse push, publish and creating agents when the target environment has no environment profile."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "agentForge.gettingStarted",
        "title": "Get started with Agent Forge for Copilot Studio",
        "description": "Design, lint, evaluate and ship multi-agent Copilot Studio solutions from VS Code.",
        "steps": [
          {
            "id": "clone",
            "title": "Bring your agents into VS Code",
            "description": "Clone every agent of your solution side by side with the Power Platform CLI, or start from the fictional Contoso sample.\n[Open Folder](command:workbench.action.files.openFolder)\n[Open Contoso Sample](command:agentForge.openSample)",
            "media": {
              "markdown": "media/walkthrough/clone.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.files.openFolder",
              "onContext:agentForge.hasAgents",
              "onCommand:agentForge.openSample"
            ]
          },
          {
            "id": "blueprint",
            "title": "Or design a new orchestrator",
            "description": "Generate an orchestrator, read-only domain agents and one write agent, optionally created live with pac.\n[New Orchestrator Blueprint](command:agentForge.newBlueprint)",
            "media": {
              "markdown": "media/walkthrough/blueprint.md"
            },
            "completionEvents": [
              "onCommand:agentForge.newBlueprint"
            ]
          },
          {
            "id": "explore",
            "title": "Explore and visualise",
            "description": "See every agent and component, then draw the orchestrator architecture.\n[Show Architecture Graph](command:agentForge.showGraph)",
            "media": {
              "markdown": "media/walkthrough/explore.md"
            },
            "completionEvents": [
              "onCommand:agentForge.showGraph"
            ]
          },
          {
            "id": "lint",
            "title": "Lint and fix",
            "description": "25 rules for routing, multi-agent depth, security and human in the loop, with quick fixes.\n[Lint Workspace](command:agentForge.lint)\n[Apply All Safe Quick Fixes](command:agentForge.fixAll)",
            "media": {
              "markdown": "media/walkthrough/lint.md"
            },
            "completionEvents": [
              "onCommand:agentForge.lint",
              "onCommand:agentForge.fixAll"
            ]
          },
          {
            "id": "ship",
            "title": "Ship with safety gates",
            "description": "Pull, push a draft and publish with lint gates, confirmations and snapshots.\n[Open Agent Forge view](command:agentForge.agents.focus)",
            "media": {
              "markdown": "media/walkthrough/ship.md"
            },
            "completionEvents": [
              "onCommand:agentForge.pull",
              "onCommand:agentForge.push",
              "onCommand:agentForge.publish"
            ]
          },
          {
            "id": "evaluate",
            "title": "Evaluate",
            "description": "Draft a test set from routing descriptions, validate it for import, then triage exported results.\n[New Evaluation Test Set](command:agentForge.newTestSet)\n[Analyse Evaluation Results](command:agentForge.analyzeResults)",
            "media": {
              "markdown": "media/walkthrough/evaluate.md"
            },
            "completionEvents": [
              "onCommand:agentForge.newTestSet",
              "onCommand:agentForge.analyzeResults"
            ]
          },
          {
            "id": "copilots",
            "title": "Add expert skills and co-pilots",
            "description": "Install skills and recipe prompts, configure the MCP servers and run portal recipes with consent gates.\n[Install Skills](command:agentForge.installSkills)\n[Run Browser Recipe](command:agentForge.runBrowserRecipe)",
            "media": {
              "markdown": "media/walkthrough/copilots.md"
            },
            "completionEvents": [
              "onCommand:agentForge.installSkills",
              "onCommand:agentForge.configureLintServer",
              "onCommand:agentForge.configureBrowser",
              "onCommand:agentForge.runBrowserRecipe"
            ]
          },
          {
            "id": "ci",
            "title": "Run the same checks in CI",
            "description": "Use the bundled command-line tool to fail builds on errors and publish SARIF.",
            "media": {
              "markdown": "media/walkthrough/ci.md"
            }
          }
        ]
      }
    ],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/copilot-studio.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scan": "node scripts/denylist-scan.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test:e2e": "vitest run test/e2e.dev.test.ts",
    "test:integration": "node test-integration/run.mjs",
    "icon": "node scripts/make-icon.mjs",
    "scan:history": "node scripts/denylist-scan.mjs --history"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "bin": {
    "agent-forge": "./dist/cli.js"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E1B4B",
    "theme": "dark"
  },
  "homepage": "https://github.com/abhilashjaiswal0110/Agent-Forge-for-Copilot-Studio#readme",
  "bugs": {
    "url": "https://github.com/abhilashjaiswal0110/Agent-Forge-for-Copilot-Studio/issues"
  },
  "qna": false,
  "pricing": "Free"
}
