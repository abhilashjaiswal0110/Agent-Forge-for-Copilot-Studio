{
  "name": "cps-agent-forge",
  "displayName": "Agent Forge for Copilot Studio",
  "description": "Design, lint, visualise and ship enterprise multi-agent orchestrators on Microsoft Copilot Studio - standard and GitHub Copilot (new agent experience) harnesses.",
  "version": "0.2.0",
  "preview": true,
  "private": true,
  "publisher": "AbhilashJaiswal",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhilashjaiswal0110/Copilotstudio-extension.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Linters",
    "Visualization"
  ],
  "keywords": [
    "copilot studio",
    "multi-agent",
    "orchestrator",
    "agents",
    "power platform",
    "connected agents",
    "mcp",
    "yaml"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/settings.mcs.yml",
    "workspaceContains:**/agent.mcs.yml"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces Agent Forge only analyses files (explorer, lint, graph). Lifecycle commands that run the Power Platform CLI require trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "agentForge.refresh",
        "title": "Refresh Agents",
        "category": "Agent Forge",
        "icon": "$(refresh)"
      },
      {
        "command": "agentForge.lint",
        "title": "Lint Workspace",
        "category": "Agent Forge"
      },
      {
        "command": "agentForge.showGraph",
        "title": "Show Architecture Graph",
        "category": "Agent Forge",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "agentForge.pull",
        "title": "Pull Agent (pac copilot pull)",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.push",
        "title": "Push Agent as Draft (pac copilot push)",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.publish",
        "title": "Publish Agent (pac copilot publish)",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.configureBrowser",
        "title": "Configure Browser Co-pilot (Playwright MCP)",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.installSkills",
        "title": "Install Copilot Studio Skills into Workspace",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.fixAll",
        "title": "Apply All Safe Quick Fixes",
        "category": "Agent Forge",
        "icon": "$(wand)"
      },
      {
        "command": "agentForge.disableRule",
        "title": "Disable Lint Rule...",
        "category": "Agent Forge"
      },
      {
        "command": "agentForge.configureLintServer",
        "title": "Configure Agent Forge MCP Server (lint, inventory, Mermaid)",
        "category": "Agent Forge",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agentForge.openWalkthrough",
        "title": "Get Started",
        "category": "Agent Forge",
        "icon": "$(question)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentForge",
          "title": "Agent Forge",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "agentForge": [
        {
          "id": "agentForge.agents",
          "name": "Agents"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentForge.agents",
        "contents": "No Copilot Studio agent found in this workspace.\nClone one with the Power Platform CLI (pac copilot clone) or the Copilot Studio extension, then refresh.\n[Refresh](command:agentForge.refresh)\n[Get Started](command:agentForge.openWalkthrough)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentForge.refresh",
          "when": "view == agentForge.agents",
          "group": "navigation"
        },
        {
          "command": "agentForge.showGraph",
          "when": "view == agentForge.agents",
          "group": "navigation"
        },
        {
          "command": "agentForge.fixAll",
          "when": "view == agentForge.agents",
          "group": "navigation@3"
        },
        {
          "command": "agentForge.openWalkthrough",
          "when": "view == agentForge.agents",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "agentForge.pull",
          "when": "view == agentForge.agents && viewItem == agent",
          "group": "lifecycle@1"
        },
        {
          "command": "agentForge.push",
          "when": "view == agentForge.agents && viewItem == agent",
          "group": "lifecycle@2"
        },
        {
          "command": "agentForge.publish",
          "when": "view == agentForge.agents && viewItem == agent",
          "group": "lifecycle@3"
        }
      ]
    },
    "configuration": {
      "title": "Agent Forge",
      "properties": {
        "agentForge.pacPath": {
          "type": "string",
          "default": "pac",
          "description": "Path to the Power Platform CLI executable."
        },
        "agentForge.lint.disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Rule IDs to disable, for example [\"DESC002\"]."
        },
        "agentForge.browser.profile": {
          "type": "string",
          "enum": [
            "isolated",
            "extension"
          ],
          "default": "isolated",
          "enumDescriptions": [
            "Playwright MCP uses an isolated, in-memory browser profile (recommended).",
            "Playwright MCP attaches to your signed-in Edge/Chrome via the Playwright browser extension."
          ],
          "description": "Browser profile used by the browser co-pilot (Playwright MCP)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "agentForge.gettingStarted",
        "title": "Get started with Agent Forge for Copilot Studio",
        "description": "Clone, explore, lint, fix and ship multi-agent Copilot Studio solutions from VS Code.",
        "steps": [
          {
            "id": "clone",
            "title": "Bring your agents into VS Code",
            "description": "Clone every agent of your solution side by side with the Power Platform CLI.\n[Open Folder](command:workbench.action.files.openFolder)",
            "media": {
              "markdown": "media/walkthrough/clone.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.files.openFolder",
              "onContext:agentForge.hasAgents"
            ]
          },
          {
            "id": "explore",
            "title": "Explore and visualise",
            "description": "See every agent and component, then draw the orchestrator architecture.\n[Show Architecture Graph](command:agentForge.showGraph)",
            "media": {
              "markdown": "media/walkthrough/explore.md"
            },
            "completionEvents": [
              "onCommand:agentForge.showGraph"
            ]
          },
          {
            "id": "lint",
            "title": "Lint and fix",
            "description": "25 rules for routing, multi-agent depth, security and human in the loop, with quick fixes.\n[Lint Workspace](command:agentForge.lint)\n[Apply All Safe Quick Fixes](command:agentForge.fixAll)",
            "media": {
              "markdown": "media/walkthrough/lint.md"
            },
            "completionEvents": [
              "onCommand:agentForge.lint",
              "onCommand:agentForge.fixAll"
            ]
          },
          {
            "id": "ship",
            "title": "Ship with safety gates",
            "description": "Pull, push a draft and publish with lint gates, confirmations and snapshots.\n[Open Agent Forge view](command:agentForge.agents.focus)",
            "media": {
              "markdown": "media/walkthrough/ship.md"
            },
            "completionEvents": [
              "onCommand:agentForge.pull",
              "onCommand:agentForge.push",
              "onCommand:agentForge.publish"
            ]
          },
          {
            "id": "copilots",
            "title": "Add expert skills and co-pilots",
            "description": "Install skills and configure the Agent Forge and browser MCP servers.\n[Install Skills](command:agentForge.installSkills)\n[Configure Agent Forge MCP Server](command:agentForge.configureLintServer)",
            "media": {
              "markdown": "media/walkthrough/copilots.md"
            },
            "completionEvents": [
              "onCommand:agentForge.installSkills",
              "onCommand:agentForge.configureLintServer",
              "onCommand:agentForge.configureBrowser"
            ]
          },
          {
            "id": "ci",
            "title": "Run the same checks in CI",
            "description": "Use the bundled command-line tool to fail builds on errors and publish SARIF.",
            "media": {
              "markdown": "media/walkthrough/ci.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scan": "node scripts/denylist-scan.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "bin": {
    "agent-forge": "./dist/cli.js"
  }
}
